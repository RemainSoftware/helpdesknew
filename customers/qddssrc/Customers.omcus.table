-- Reference file OMSREFHD                                 --          
-- Record OMCUSR                                           --          
--                                                         --          
-------------------------------------------------------------          
CREATE or replace TABLE OMCUS AS (                                     
  select                                                               
   cusc as USCUSC,                                                     
   namd as USNAMD,                                                     
   adst as USADST,                                                     
   zipc as USZIPC,                                                     
   adre as USADRE,                                                     
   coud as USCOUD,                                                     
   usf1 as USUSF1,                                                     
   usf2 as USUSF2,                                                     
   usf3 as USUSF3 from omhd_prd/omsrefhd)
                                           
 definition only RCDFMT OMCUSR;            
                                           
 LABEL ON TABLE OMCUS                      
 IS 'OMS - Customers' ;                         